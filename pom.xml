<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.scijava</groupId>
    <artifactId>pom-scijava</artifactId>
    <version>45.0.0</version>
    <relativePath />
  </parent>

  <groupId>io.github.alzeiby</groupId>
  <artifactId>anmj-morph-plus</artifactId>
  <version>0.1.1</version>

  <name>aNMJ-morph+</name>
  <description>Fiji plugin for quantitative neuromuscular junction morphology analysis.</description>
  <url>https://github.com/alzeiby/aNMJ-morph-plus</url>
  <inceptionYear>2026</inceptionYear>

  <organization>
    <name>aNMJ-morph+ project</name>
    <url>https://github.com/alzeiby/aNMJ-morph-plus</url>
  </organization>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/license/mit</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>alzeiby</id>
      <name>Abdullah Alzeiby</name>
      <url>https://github.com/alzeiby</url>
      <roles>
        <role>founder</role>
        <role>lead</role>
        <role>developer</role>
        <role>maintainer</role>
      </roles>
    </developer>
  </developers>

  <contributors>
    <contributor>
      <name>Original aNMJ-morph authors</name>
      <roles>
        <role>developer</role>
      </roles>
    </contributor>
  </contributors>

  <mailingLists>
    <mailingList>
      <name>Image.sc Forum</name>
      <archive>https://forum.image.sc/tag/imagej</archive>
    </mailingList>
  </mailingLists>

  <scm>
    <connection>scm:git:https://github.com/alzeiby/aNMJ-morph-plus.git</connection>
    <developerConnection>scm:git:git@github.com:alzeiby/aNMJ-morph-plus.git</developerConnection>
    <tag>HEAD</tag>
    <url>https://github.com/alzeiby/aNMJ-morph-plus</url>
  </scm>

  <issueManagement>
    <system>GitHub Issues</system>
    <url>https://github.com/alzeiby/aNMJ-morph-plus/issues</url>
  </issueManagement>

  <ciManagement>
    <system>GitHub Actions</system>
    <url>https://github.com/alzeiby/aNMJ-morph-plus/actions</url>
  </ciManagement>

  <properties>
    <package-name>io.github.alzeiby.anmjmorphplus</package-name>
    <license.licenseName>mit</license.licenseName>
    <license.copyrightOwners>Abdullah Alzeiby</license.copyrightOwners>
    <bio-formats.version>8.5.0</bio-formats.version>
  </properties>

  <repositories>
    <repository>
      <id>scijava.public</id>
      <url>https://maven.scijava.org/content/groups/public</url>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>org.scijava</groupId>
      <artifactId>scijava-common</artifactId>
    </dependency>
    <dependency>
      <groupId>net.imagej</groupId>
      <artifactId>ij</artifactId>
    </dependency>
    <dependency>
      <groupId>ome</groupId>
      <artifactId>bio-formats_plugins</artifactId>
      <version>${bio-formats.version}</version>
    </dependency>
    <dependency>
      <groupId>sc.fiji</groupId>
      <artifactId>AnalyzeSkeleton_</artifactId>
    </dependency>
  </dependencies>

</project>
